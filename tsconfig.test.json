{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  // Testovi build skripti uvlace `scripts/`, pa im trebaju i deklaracije za
  // pakete bez tipova (`subset-font`, `mapshaper`) koje ondje zive.
  "include": ["tests", "scripts/**/*.d.ts"]
}
